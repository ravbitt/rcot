# Base de datos (en Coolify: la URL interna del Postgres del proyecto)
DATABASE_URL=postgres://cotas:cotas@localhost:5434/cotas

# Better Auth: URL pública de la app y secreto (openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=cambia-esto
# Otros orígenes permitidos, separados por coma (p. ej. con y sin www)
BETTER_AUTH_TRUSTED_ORIGINS=

# Administrador inicial: se crea al arrancar el contenedor si todavía no hay ninguno
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Carpeta de modelos subidos (en producción: volumen persistente montado en /app/data)
UPLOAD_DIR=data/uploads
# Tamaño máximo de un modelo subido, en MB
MAX_UPLOAD_MB=100
